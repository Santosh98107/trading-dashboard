import numpy as np
import pandas as pd

try:
    import talib
    TALIB_AVAILABLE = True
except Exception:
    TALIB_AVAILABLE = False

from core.utils import safe_divide, rolling_slope, ensure_ohlcv


class FeatureEngine:
    def __init__(self, config):
        self.cfg = config
        self.use_talib = config.use_talib and TALIB_AVAILABLE

    def add_indicators(self, df):
        df = ensure_ohlcv(df)

        close = df["Close"]
        high = df["High"]
        low = df["Low"]
        volume = df["Volume"]

        df["EMA20"] = close.ewm(span=self.cfg.ema_fast, adjust=False).mean()
        df["EMA50"] = close.ewm(span=self.cfg.ema_slow, adjust=False).mean()
        df["EMA200"] = close.ewm(span=self.cfg.ema_long, adjust=False).mean()
        df["SMA20"] = close.rolling(self.cfg.sma_period).mean()

        tp = (high + low + close) / 3.0
        cum_vol = volume.cumsum().replace(0, np.nan)
        df["VWAP"] = (tp * volume).cumsum() / cum_vol

        delta = close.diff()
        gain = delta.clip(lower=0)
        loss = -delta.clip(upper=0)
        avg_gain = gain.rolling(self.cfg.rsi_period).mean()
        avg_loss = loss.rolling(self.cfg.rsi_period).mean()
        rs = avg_gain / avg_loss.replace(0, np.nan)
        df["RSI"] = 100 - (100 / (1 + rs))

        ema_fast = close.ewm(span=self.cfg.macd_fast, adjust=False).mean()
        ema_slow = close.ewm(span=self.cfg.macd_slow, adjust=False).mean()
        df["MACD"] = ema_fast - ema_slow
        df["SignalLine"] = df["MACD"].ewm(span=self.cfg.macd_signal, adjust=False).mean()
        df["MACD_Hist"] = df["MACD"] - df["SignalLine"]

        prev_close = close.shift(1)
        tr1 = high - low
        tr2 = (high - prev_close).abs()
        tr3 = (low - prev_close).abs()
        tr = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1)

        df["ATR"] = tr.rolling(self.cfg.atr_period).mean()
        df["ATR_Pct"] = safe_divide(df["ATR"], close) * 100

        std = close.rolling(self.cfg.bb_period).std()
        df["BB_Upper"] = df["SMA20"] + self.cfg.bb_std * std
        df["BB_Lower"] = df["SMA20"] - self.cfg.bb_std * std
        df["BB_Width"] = df["BB_Upper"] - df["BB_Lower"]

        df["Volume_MA20"] = volume.rolling(self.cfg.volume_ma_period).mean()
        df["RVOL"] = safe_divide(volume, df["Volume_MA20"])
        df["Volume_Spike"] = volume > (self.cfg.volume_spike_mult * df["Volume_MA20"])

        low_n = low.rolling(self.cfg.stoch_period).min()
        high_n = high.rolling(self.cfg.stoch_period).max()
        df["StochK"] = safe_divide((close - low_n), (high_n - low_n)) * 100
        df["StochD"] = pd.Series(df["StochK"], index=df.index).rolling(self.cfg.stoch_signal).mean()

        up_move = high.diff()
        down_move = -low.diff()
        plus_dm = np.where((up_move > down_move) & (up_move > 0), up_move, 0.0)
        minus_dm = np.where((down_move > up_move) & (down_move > 0), down_move, 0.0)

        tr_n = tr.rolling(self.cfg.adx_period).sum()
        plus_dm_n = pd.Series(plus_dm, index=df.index).rolling(self.cfg.adx_period).sum()
        minus_dm_n = pd.Series(minus_dm, index=df.index).rolling(self.cfg.adx_period).sum()

        df["PlusDI"] = safe_divide(100 * plus_dm_n, tr_n)
        df["MinusDI"] = safe_divide(100 * minus_dm_n, tr_n)
        dx = safe_divide((df["PlusDI"] - df["MinusDI"]).abs(), (df["PlusDI"] + df["MinusDI"])) * 100
        df["ADX"] = pd.Series(dx, index=df.index).rolling(self.cfg.adx_period).mean()

        df["EMA20_Slope"] = rolling_slope(df["EMA20"], self.cfg.slope_window)
        df["EMA50_Slope"] = rolling_slope(df["EMA50"], self.cfg.slope_window)
        df["RSI_Slope"] = rolling_slope(df["RSI"], self.cfg.slope_window)

        df["HigherHigh"] = high > high.shift(1)
        df["HigherLow"] = low > low.shift(1)
        df["LowerHigh"] = high < high.shift(1)
        df["LowerLow"] = low < low.shift(1)
        df["HH_HL_Structure"] = df["HigherHigh"] & df["HigherLow"]
        df["LH_LL_Structure"] = df["LowerHigh"] & df["LowerLow"]

        lookback = 20
        rolling_prev_high = high.shift(1).rolling(lookback).max()
        rolling_prev_low = low.shift(1).rolling(lookback).min()
        df["Breakout"] = close > rolling_prev_high
        df["Breakdown"] = close < rolling_prev_low
        df["DistanceToResistance"] = rolling_prev_high - close
        df["DistanceToSupport"] = close - rolling_prev_low

        df["FutureReturn_1"] = safe_divide(close.shift(-1) - close, close) * 100
        df["FutureReturn_3"] = safe_divide(close.shift(-3) - close, close) * 100
        df["FutureReturn_5"] = safe_divide(close.shift(-5) - close, close) * 100
        df["FutureReturn_10"] = safe_divide(close.shift(-10) - close, close) * 100

        return df

    def add_patterns(self, df):
        df = df.copy()

        open_ = df["Open"]
        high = df["High"]
        low = df["Low"]
        close = df["Close"]

        body = (close - open_).abs()
        full_range = high - low
        upper_wick = high - pd.concat([open_, close], axis=1).max(axis=1)
        lower_wick = pd.concat([open_, close], axis=1).min(axis=1) - low

        df["BodySize"] = body
        df["Range"] = full_range
        df["UpperWick"] = upper_wick
        df["LowerWick"] = lower_wick
        df["BodyToRangeRatio"] = np.where(full_range > 0, body / full_range, 0)
        df["ClosePositionInRange"] = np.where(full_range > 0, (close - low) / full_range, 0)

        prev_open = open_.shift(1)
        prev_close = close.shift(1)

        prev_body_high = pd.concat([prev_open, prev_close], axis=1).max(axis=1)
        prev_body_low = pd.concat([prev_open, prev_close], axis=1).min(axis=1)
        body_high = pd.concat([open_, close], axis=1).max(axis=1)
        body_low = pd.concat([open_, close], axis=1).min(axis=1)

        df["Doji"] = df["BodyToRangeRatio"] <= 0.1
        df["Hammer"] = (lower_wick >= 2 * body) & (upper_wick <= body)
        df["ShootingStar"] = (upper_wick >= 2 * body) & (lower_wick <= body)
        df["BullishEngulfing"] = (
            (prev_close < prev_open) &
            (close > open_) &
            (body_low <= prev_body_low) &
            (body_high >= prev_body_high)
        )
        df["BearishEngulfing"] = (
            (prev_close > prev_open) &
            (close < open_) &
            (body_high >= prev_body_high) &
            (body_low <= prev_body_low)
        )
        df["InsideBar"] = (high < high.shift(1)) & (low > low.shift(1))
        df["OutsideBar"] = (high > high.shift(1)) & (low < low.shift(1))

        return df

    def add_scores(self, df):
        df = df.copy()

        bullish_pattern = (
            df["BullishEngulfing"] |
            df["Hammer"]
        )

        bearish_pattern = (
            df["BearishEngulfing"] |
            df["ShootingStar"]
        )

        bull = (
            (df["Close"] > df["EMA20"]).astype(int) +
            (df["EMA20"] > df["EMA50"]).astype(int) +
            (df["EMA50"] > df["EMA200"]).astype(int) +
            (df["Close"] > df["VWAP"]).astype(int) +
            (df["RSI"] > 55).astype(int) +
            (df["MACD_Hist"] > 0).astype(int) +
            (df["ADX"] > self.cfg.adx_threshold).astype(int) +
            (df["PlusDI"] > df["MinusDI"]).astype(int) +
            df["Volume_Spike"].astype(int) +
            (df["RVOL"] > self.cfg.rvol_threshold).astype(int) +
            df["HH_HL_Structure"].astype(int) +
            df["Breakout"].astype(int) +
            bullish_pattern.astype(int)
        )

        bear = (
            (df["Close"] < df["EMA20"]).astype(int) +
            (df["EMA20"] < df["EMA50"]).astype(int) +
            (df["EMA50"] < df["EMA200"]).astype(int) +
            (df["Close"] < df["VWAP"]).astype(int) +
            (df["RSI"] < 45).astype(int) +
            (df["MACD_Hist"] < 0).astype(int) +
            (df["ADX"] > self.cfg.adx_threshold).astype(int) +
            (df["MinusDI"] > df["PlusDI"]).astype(int) +
            df["Volume_Spike"].astype(int) +
            (df["RVOL"] > self.cfg.rvol_threshold).astype(int) +
            df["LH_LL_Structure"].astype(int) +
            df["Breakdown"].astype(int) +
            bearish_pattern.astype(int)
        )

        buy = (bull >= self.cfg.bullish_score_threshold) & ((bull - bear) >= self.cfg.min_score_gap)
        sell = (bear >= self.cfg.bearish_score_threshold) & ((bear - bull) >= self.cfg.min_score_gap)

        if self.cfg.strict_trend_filter:
            buy = buy & (df["Close"] > df["EMA200"])
            sell = sell & (df["Close"] < df["EMA200"])

        df["BullishConfluenceScore"] = bull
        df["BearishConfluenceScore"] = bear
        df["RawBuySignal"] = buy
        df["RawSellSignal"] = sell
        df["ExecuteBuyNextBar"] = buy.shift(1).fillna(False)
        df["ExecuteSellNextBar"] = sell.shift(1).fillna(False)

        return df

    def transform(self, df):
        out = self.add_indicators(df)
        out = self.add_patterns(out)
        out = self.add_scores(out)
        return out
